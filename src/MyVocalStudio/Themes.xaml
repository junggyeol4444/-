<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="Bg" Color="#090A0E"/><SolidColorBrush x:Key="Panel" Color="#111218"/><SolidColorBrush x:Key="Panel2" Color="#181920"/><SolidColorBrush x:Key="Line" Color="#292B33"/><SolidColorBrush x:Key="Text" Color="#ECECF2"/><SolidColorBrush x:Key="Muted" Color="#747681"/><SolidColorBrush x:Key="Accent" Color="#FF6C62"/>
<Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#14151A"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="Slider"><Setter Property="Margin" Value="5"/></Style><Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style><Style TargetType="TabItem"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="12,7"/></Style>
</ResourceDictionary>
