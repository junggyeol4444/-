<Window x:Class="MyVocalStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MYVOCAL Studio" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
<Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
<Border Background="#0E0F14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource Accent}" CornerRadius="7" Width="32" Height="32"><TextBlock Text="M" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0"><TextBlock Text="MYVOCAL" FontWeight="Bold"/><TextBlock Text="STUDIO" FontSize="8" Foreground="{StaticResource Muted}"/></StackPanel><Separator Margin="16,8"/><TextBlock x:Name="ProjectTitle" Text="다시, 우리" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="◀◀" Click="Rewind_Click"/><Button x:Name="PlayButton" Content="▶" Background="{StaticResource Accent}" Click="Play_Click"/><Button Content="■" Click="Stop_Click"/><TextBlock x:Name="TimeText" Text="01:12.000" FontFamily="Consolas" FontWeight="Bold" FontSize="15" Margin="14,0" VerticalAlignment="Center"/><TextBlock Text="128.0&#x0a;BPM" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="A min&#x0a;KEY" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="9" Margin="14,0" VerticalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="프로젝트 열기" Click="Open_Click"/><Button Content="저장" Click="Save_Click"/><Button Content="내보내기" Click="Export_Click"/><Button Content="✦ RENDER" Background="{StaticResource Accent}" Click="Export_Click"/></StackPanel></Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Background="#0D0E13" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><StackPanel><ToggleButton Content="♫&#x0a;MUSIC" IsChecked="True"/><ToggleButton Content="◉&#x0a;VOICE"/><ToggleButton Content="♙&#x0a;CHARACTER"/><ToggleButton Content="▣&#x0a;VIDEO"/><ToggleButton Content="▦&#x0a;LIBRARY"/></StackPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="26"/><RowDefinition/><RowDefinition Height="220"/></Grid.RowDefinitions>
<Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel Margin="10,0"><TextBlock Text="Music Studio" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="＋ TRACK" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="AddTrack_Click"/><CheckBox Content="SNAP" x:Name="SnapCheck" IsChecked="True" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="20,0"/></DockPanel></Border>
<Grid Grid.Row="1" Background="#101117"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="INTRO"/><TextBlock Grid.Column="1" Text="VERSE 1"/><TextBlock Grid.Column="2" Text="PRE-CHORUS"/><TextBlock Grid.Column="3" Text="CHORUS"/><TextBlock Grid.Column="4" Text="VERSE 2"/><TextBlock Grid.Column="5" Text="BRIDGE"/></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Hidden"><ItemsControl x:Name="TrackHeaders"/></ScrollViewer><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="Timeline" Width="1500" Height="500" Background="#0D0E13" MouseLeftButtonDown="Timeline_MouseLeftButtonDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseLeftButtonUp"/></ScrollViewer></Grid>
<TabControl Grid.Row="3"><TabItem Header="LYRICS"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VERSE 1" Foreground="#C57A9A"/><TextBlock Text="마디 9–16" FontWeight="Bold" Margin="0,8"/></StackPanel><TextBox Grid.Column="1" x:Name="LyricsText" AcceptsReturn="True" TextWrapping="Wrap" Text="길었던 계절 끝에 네가 서 있어&#x0a;&#x0a;잊었던 이름을 다시 불러 봐&#x0a;&#x0a;멈춰 있던 시간이 흐르기 시작해"/><Button Grid.Column="2" Content="✦ AI 다시 쓰기" VerticalAlignment="Top" Click="Rewrite_Click"/></Grid></TabItem><TabItem Header="PIANO ROLL"><Canvas x:Name="PianoRoll" Background="#111218" Loaded="PianoRoll_Loaded"/></TabItem><TabItem Header="AUTOMATION"><Canvas x:Name="Automation" Background="#111218" Loaded="Automation_Loaded"/></TabItem><TabItem Header="STORYBOARD"><ItemsControl x:Name="Storyboard"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></TabItem></TabControl></Grid>
<Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="120"/><RowDefinition/><RowDefinition Height="110"/></Grid.RowDefinitions><TextBlock Text="AI PRODUCER" FontFamily="Consolas" FontWeight="Bold" Margin="14"/><Border Grid.Row="1" Background="#19181E" Margin="10"><StackPanel Margin="10"><TextBlock Text="SUGGESTION" Foreground="#C381DC" FontFamily="Consolas" FontSize="9"/><TextBlock Text="후렴의 에너지를 더 높일 수 있어요." Margin="0,8"/><StackPanel Orientation="Horizontal"><Button Content="드럼 강화" Click="Drums_Click"/><Button Content="화음 추가" Click="Harmony_Click"/></StackPanel></StackPanel></Border><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="110"/></Grid.RowDefinitions><TextBox x:Name="ChatLog" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Text="✦ 무엇을 바꿔드릴까요? 프로젝트의 트랙과 구조를 직접 수정할 수 있어요."/><StackPanel Grid.Row="1" Margin="10"><TextBox x:Name="AiPrompt" Height="56" AcceptsReturn="True" Text="마지막 후렴만 반키 올려줘"/><Button Content="프로젝트에 적용 ↑" HorizontalAlignment="Right" Background="{StaticResource Accent}" Click="AiApply_Click"/></StackPanel></Grid><StackPanel Grid.Row="3" Background="#0E0F14" Margin="0,1,0,0"><TextBlock Text="MASTER                                      -6.2 dB" FontFamily="Consolas" Margin="12"/><Slider Value="78"/></StackPanel></Grid></Border>
</Grid></Grid></Window>
